# --- Деплой ---
# Домен, на котором открывается MiniApp (Caddy сам получит HTTPS-сертификат)
DOMAIN=fin.izzinet.xyz

# --- Сервер ---
PORT=8080
# Токен бота из BotFather: нужен для проверки подписи initData
BOT_TOKEN=
# Источник цен: binance | mock (mock — случайное блуждание для локальной разработки)
PRICE_FEED=binance
# Откуда разрешены запросы MiniApp (CORS), через запятую
CORS_ORIGINS=https://fin.izzinet.xyz,http://localhost:5173
# Разрешить вход без Telegram для локальной разработки (никогда не включать в проде)
DEV_AUTH_BYPASS=false

# --- MiniApp ---
# Пусто: в проде API на том же домене, локально http://localhost:8080
VITE_API_URL=

# --- Бот ---
# HTTPS-адрес, где опубликован MiniApp
WEBAPP_URL=https://fin.izzinet.xyz

# --- База данных ---
# По умолчанию встроенный PostgreSQL (PGlite) в папке data/. Для отдельного сервера:
# DATABASE_URL=postgres://financio:financio@postgres:5432/financio
DATABASE_URL=pglite://./data/pglite

# --- Админка ---
# Telegram ID админов через запятую: у них в MiniApp появится вкладка «Админ».
# Свой ID видно в игре на вкладке «Профиль».
ADMIN_TELEGRAM_IDS=
# Необязательно: пароль для страницы https://<домен>/admin в обычном браузере,
# не короче 16 символов. Сгенерировать: openssl rand -hex 24
ADMIN_TOKEN=
